rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validLevel(value) {
      return value in ['N5', 'N4', 'N3', 'N2', 'N1'];
    }

    match /vocabulary/{vocabularyId} {
      allow get, list: if signedIn() && resource.data.isActive == true;
      allow create, update, delete: if false;
    }

    match /quizQuestions/{questionId} {
      allow get, list: if signedIn() && resource.data.isActive == true;
      allow create, update, delete: if false;
    }

    // Only trusted Admin SDK code (for example Cloud Functions) may enqueue or
    // inspect push jobs. Admin SDK requests bypass Firestore Security Rules.
    match /notificationJobs/{jobId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if owns(userId);
      allow create: if owns(userId)
        && request.resource.data.isAnonymous is bool
        && request.resource.data.isAnonymous
          == (request.auth.token.firebase.sign_in_provider == 'anonymous');
      allow update: if owns(userId)
        && request.resource.data.isAnonymous is bool
        && (!('selectedJlptLevel' in request.resource.data)
          || validLevel(request.resource.data.selectedJlptLevel))
        && (!('dailyGoal' in request.resource.data)
          || request.resource.data.dailyGoal is int
          && request.resource.data.dailyGoal >= 1
          && request.resource.data.dailyGoal <= 100);
      allow delete: if false;

      match /vocabularyProgress/{vocabularyId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.vocabularyId == vocabularyId
          && validLevel(request.resource.data.jlptLevel)
          && request.resource.data.state in [
            'newWord', 'learning', 'review', 'relearning', 'mastered', 'suspended'
          ];
      }

      match /devices/{deviceId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.keys().hasOnly([
            'token', 'platform', 'enabled', 'updatedAt'
          ])
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 20
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform in ['android', 'ios']
          && request.resource.data.enabled is bool
          && request.resource.data.updatedAt is timestamp;
      }

      match /{collection}/{document=**} {
        // Keep the general per-user storage behavior while ensuring the
        // stricter schemas above cannot be bypassed by this recursive rule.
        allow read, write: if owns(userId)
          && !(collection in ['devices', 'vocabularyProgress']);
      }
    }
  }
}
